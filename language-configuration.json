{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}\"]*$|\\([^)\"]*$|\\[[^\\]\"]*$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*///.*$",
      "action": { "indent": "none", "appendText": "/// " }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#(if|ifdef|ifndef)\\b|^\\s*//\\s*#?region\\b",
      "end": "^\\s*#endif\\b|^\\s*//\\s*#?endregion\\b"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d[\\w.]*"
}
